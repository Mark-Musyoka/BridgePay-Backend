# Copy this to .env and fill in real values. Never commit .env itself.

# Neon Postgres connection string (async driver: postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

ENVIRONMENT=development

# Comma-separated deployed frontend origin(s), e.g. Vercel URL.
# Local dev (localhost/127.0.0.1, any port) is always allowed separately —
# no need to list it here.
ALLOWED_ORIGINS=

# Stripe (card deposits/payouts) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa Daraja (STK Push deposits, B2C payouts) — https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_B2C_CERT_PATH=
MPESA_CALLBACK_BASE_URL=

# Airtel Money (Collections deposits, Disbursement payouts) — https://developers.airtel.africa
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_SECRET=
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_ENCRYPTION_PUBLIC_KEY_PATH=
AIRTEL_CALLBACK_BASE_URL=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_OAUTH_COMPLETE_URL=

# SMTP (real email sending) — blank SMTP_HOST means "not configured";
# every email task falls back to its original mocked (log-only)
# behavior rather than failing. Works with any real SMTP provider.
#
# For Resend (https://resend.com — recommended, generous free tier):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend          <- literally the word "resend"
#   SMTP_PASSWORD=<your re_... API key, from https://resend.com/api-keys>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=BridgePay

# This app's own frontend base URL, used to build the links inside
# verification/password-reset emails. Local dev default already
# matches the frontend's default dev server — only change this for a
# deployed frontend.
FRONTEND_BASE_URL=http://localhost:3000
